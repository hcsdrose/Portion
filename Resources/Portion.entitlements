<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the Mac App Store. Portion needs no other entitlements: screen capture
         is granted by the user in System Settings (Screen & System Audio Recording), and it
         uses no network, files, camera, microphone or contacts. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
